<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
>
	<testsuites>
		<testsuite name="unit">
			<directory prefix="test-" suffix=".php">tests/unit</directory>
		</testsuite>
		<testsuite name="integration">
			<directory prefix="test-" suffix=".php">tests/integration</directory>
		</testsuite>
	</testsuites>
</phpunit>
