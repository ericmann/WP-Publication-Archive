      ]
    },
    {
      "id": "no-jquery",
      "description": "SPEC §3 P19: no jQuery or $( in js/ or blocks/.",
      "paths": [
        "js/",
        "blocks/"
      ],
      "pattern": "\\bjQuery\\b|(?<![A-Za-z0-9_.$])\\$\\(",
      "shouldMatch": [
        "jQuery( document ).on( 'click', fn );",
        "$( '.row' ).hide();"
      ],
      "shouldNotMatch": [
