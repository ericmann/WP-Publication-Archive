      "paths": [
        "includes/",
        "blocks/",
        "templates/",
        "wp-publication-archive.php",
        "uninstall.php"
      ],
      "exclude": [
        "includes/compat/class-shortcode.php"
      ],
      "pattern": "\\$_(POST|GET|REQUEST)\\b",
      "shouldMatch": [
        "$paged = $_GET['wpa-paged'];",
        "if ( isset( $_POST['x'] ) ) {"
      ],
      "shouldNotMatch": [
        "$paged = get_query_var( Keys::QV_PAGED );",
        "$_SERVER['REQUEST_URI']"
      ]
    },
    {
      "id": "no-dangerous-html",
      "description": "SPEC §3 P18: no dangerouslySetInnerHTML in js/ or blocks/.",
      "paths": [
        "js/",
        "blocks/"
      ],
      "pattern": "dangerouslySetInnerHTML",
      "shouldMatch": [
