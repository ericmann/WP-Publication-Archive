<?xml version="1.0"?>
<ruleset name="wp-publication-archive">
	<description>WordPress VIP Go coding standard for wp-publication-archive.</description>

	<file>wp-publication-archive.php</file>
	<file>includes</file>
	<file>templates</file>
	<file>tests</file>
	<file>bin</file>

	<exclude-pattern>vendor/*</exclude-pattern>
	<exclude-pattern>node_modules/*</exclude-pattern>
	<exclude-pattern>.cache/*</exclude-pattern>
	<exclude-pattern>dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<config name="text_domain" value="wp-publication-archive"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress-VIP-Go"/>

	<rule ref="WordPress.Security">
		<severity>5</severity>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<severity>5</severity>
	</rule>
	<rule ref="WordPress.DateTime.RestrictedFunctions">
		<severity>5</severity>
	</rule>
	<rule ref="WordPress.PHP.DontExtract">
		<severity>5</severity>
	</rule>
	<rule ref="WordPress.PHP.DevelopmentFunctions">
		<severity>5</severity>
	</rule>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>tests/*</exclude-pattern>
		<exclude-pattern>bin/*</exclude-pattern>
	</rule>

	<!--
		SPEC §7.3 exempts WordPress.Files.FileName for templates/classic/
		(theme override names are frozen to the 3.0.1 names). VIP-Go does not
		pull that sniff in from WordPress-Core, so it never runs here; adding
		it fresh would also flag pre-existing, out-of-scope files (test
		shims, leaf classes) that this task does not touch. The exemption is
		satisfied because the sniff is not active project-wide.
	-->
</ruleset>
